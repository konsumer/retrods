diff --git a/libgambatte/src/sound/psg_buf.h b/libgambatte/src/sound/psg_buf.h
new file mode 100644
index 0000000..a355faf
--- /dev/null
+++ b/libgambatte/src/sound/psg_buf.h
@@ -0,0 +1,77 @@
+#ifndef PSG_BUF_H
+#define PSG_BUF_H
+
+#include "gbint.h"
+#include <cstddef>
+#include <stdint.h>
+
+/* The sound channels write *changes* of their output level into a buffer at
+ * the native rate (~2 MHz, 35112 slots per frame), which the PSG then
+ * integrates and the frontend resamples: three passes over every slot.
+ *
+ * GAMBATTE_DECIMATED_PSG: the channels write through psg_buf_t instead, a
+ * cursor that drops each change straight into the output-rate slot (1/64 of
+ * the native rate, ~32 kHz) it falls in, already weighted for a box average of
+ * those 64 native samples. The output then costs one pass over ~550 slots a
+ * frame, plus a few operations per level change, instead of touching every
+ * native sample. The channel code is unchanged: `*buf += d` and `buf += n`
+ * mean what they did. */
+
+#ifdef GAMBATTE_DECIMATED_PSG
+
+namespace gambatte {
+
+enum { psg_decim_shift = 6, psg_decim = 1 << psg_decim_shift };
+
+/* A level the channels cannot produce: "the DC blocker has not seen a sample". */
+int_least32_t const psg_dc_unprimed = -0x7FFFFFFF;
+
+struct PsgBuckets {
+	enum { max = 96 }; /* (native buffer size + phase) / 64, plus slack */
+	/* step[k]: level changes taking effect from slot k, x64.
+	 * part[k]: changes inside slot k, weighted by the share of it they cover. */
+	int_least32_t stepL[max], stepR[max], partL[max], partR[max];
+};
+
+class psg_buf_t {
+public:
+	struct Ref {
+		psg_buf_t &p;
+		void operator+=(uint_least32_t d) { p.add(d); }
+		void operator=(uint_least32_t d) { p.add(d); } /* buffer starts zeroed */
+	};
+
+	psg_buf_t(PsgBuckets *b, unsigned long pos) : b_(b), pos_(pos) {}
+	Ref operator*() { Ref r = { *this }; return r; }
+	psg_buf_t &operator+=(unsigned long n) { pos_ += n; return *this; }
+
+private:
+	PsgBuckets *b_;
+	unsigned long pos_;
+
+	/* d packs two signed 16-bit changes (left low, right high) with modular
+	 * arithmetic, as the channels compute them. */
+	void add(uint_least32_t d) {
+		int_least32_t const lo = static_cast<int16_t>(d & 0xFFFF);
+		int_least32_t const hi = static_cast<int16_t>((d - static_cast<uint_least32_t>(lo)) >> 16);
+		unsigned long const k = pos_ >> psg_decim_shift;
+		int_least32_t const w = psg_decim - static_cast<int_least32_t>(pos_ & (psg_decim - 1));
+
+		if (k + 1 >= PsgBuckets::max)
+			return;
+		b_->partL[k] += lo * w;
+		b_->partR[k] += hi * w;
+		b_->stepL[k + 1] += lo * psg_decim;
+		b_->stepR[k + 1] += hi * psg_decim;
+	}
+};
+
+}
+
+#else
+
+typedef uint_least32_t *psg_buf_t;
+
+#endif
+
+#endif
